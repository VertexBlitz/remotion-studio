{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "skipLibCheck": true,
    "strict": true, "jsx": "react-jsx", "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, "noEmit": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "remotion", "server", "vite.config.ts"]
}